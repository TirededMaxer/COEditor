+/* COEditor: per-layer pacing and actual drawable-presentation feedback.
+ * Included by d3dmetal_objc.m. No exported ABI or app/helper signature changes. */
+#include "cx_frame_control.h"
+#import <CoreVideo/CoreVideo.h>
+#include <mach/mach_time.h>
+#include <mach/mach.h>
+static int cx_frame_fps, cx_frame_stats, cx_frame_pacing;
+
+@interface CXFrameControl : NSObject {
+    NSCondition *condition;
+    NSMutableDictionary *pending;
+    struct cx_frame_clock clock;
+    unsigned long sequence, timeouts;
+    double last_report, period;
+    NSString *output;
+}
+- (void)waitForFrame;
+- (void)track:(id<CAMetalDrawable>)drawable size:(CGSize)size;
+- (void)presented:(double)time token:(NSNumber *)token size:(CGSize)size;
+@end
+
+@implementation CXFrameControl
+- (id)init
+{
+    if ((self = [super init])) {
+        condition = [[NSCondition alloc] init]; pending = [[NSMutableDictionary alloc] init];
+        period = 1.0 / 60;
+        CVDisplayLinkRef link = NULL;
+        if (CVDisplayLinkCreateWithCGDisplay(CGMainDisplayID(), &link) == kCVReturnSuccess) {
+            CVTime nominal = CVDisplayLinkGetNominalOutputVideoRefreshPeriod(link);
+            if (!(nominal.flags & kCVTimeIsIndefinite) && nominal.timeScale > 0 && nominal.timeValue > 0)
+                period = (double)nominal.timeValue / nominal.timeScale;
+            CVDisplayLinkRelease(link);
+        }
+        const char *prefix = getenv("WINEPREFIX");
+        if (cx_frame_stats && prefix) {
+            NSString *directory = [[NSString stringWithUTF8String:prefix] stringByAppendingPathComponent:@"drive_c/.cx-frame-stats"];
+            [[NSFileManager defaultManager] createDirectoryAtPath:directory withIntermediateDirectories:YES attributes:nil error:NULL];
+            output = [[directory stringByAppendingPathComponent:[NSString stringWithFormat:@"%d-%p.json", getpid(), self]] copy];
+        }
+    }
+    return self;
+}
+- (void)dealloc
+{
+    [condition release]; [pending release]; [output release]; [super dealloc];
+}
+- (void)waitForFrame
+{
+    [condition lock];
+    double began = CACurrentMediaTime();
+    unsigned limit = cx_frame_pacing == 2 ? 1 : 2;
+    for (;;) {
+        double now = CACurrentMediaTime();
+        /* An acquired drawable may never be presented (resize/background/drop).
+         * Expire those tickets and bound feedback waiting; never stall the game
+         * indefinitely when callbacks stop or the GPU is heavily overloaded. */
+        NSArray *keys = [[pending allKeys] copy];
+        for (NSNumber *key in keys) if (now - [[pending objectForKey:key] doubleValue] > .25) [pending removeObjectForKey:key];
+        [keys release];
+        BOOL feedback = cx_frame_pacing && [pending count] >= limit;
+        double due = fmax(clock.last_start + period / (cx_frame_pacing == 2 ? 1 : 2), clock.latest + period * .25);
+        /* Presentation callbacks can reach us after the display deadline. Let
+         * the next frame start on its display cadence instead of serializing
+         * CPU/GPU work behind a late callback. The drawable pool still bounds
+         * work in flight. Cold/occluded surfaces use the bounded feedback wait. */
+        if (feedback && clock.latest > 0 && now - clock.latest < .25 && now >= due) feedback = NO;
+        if (feedback && now - began >= .1) { ++timeouts; feedback = NO; }
+        double delay = cx_frame_deadline(&clock, now, cx_frame_fps) - now;
+        if (!feedback && delay <= .000001) break;
+        if (!feedback && delay > .000001) {
+            static mach_timebase_info_data_t timebase;
+            static dispatch_once_t once;
+            dispatch_once(&once, ^{ mach_timebase_info(&timebase); });
+            uint64_t deadline = mach_absolute_time() + (uint64_t)(delay * 1e9 * timebase.denom / timebase.numer);
+            [condition unlock];
+            mach_wait_until(deadline);
+            [condition lock];
+            continue;
+        }
+        double wait = feedback ? fmin(.005, fmax(.00005, due - now)) : fmin(delay, .05);
+        [condition waitUntilDate:[NSDate dateWithTimeIntervalSinceNow:wait]];
+    }
+    clock.last_start = CACurrentMediaTime();
+    [condition unlock];
+}
+- (void)track:(id<CAMetalDrawable>)drawable size:(CGSize)size
+{
+    if (!drawable || (!cx_frame_stats && !cx_frame_pacing)) return;
+    [condition lock];
+    NSNumber *token = [NSNumber numberWithUnsignedLong:++sequence];
+    if (cx_frame_pacing) [pending setObject:@(CACurrentMediaTime()) forKey:token];
+    [condition unlock];
+    [drawable addPresentedHandler:^(id<MTLDrawable> done) {
+        [self presented:done.presentedTime token:token size:size];
+    }];
+}
+- (void)presented:(double)time token:(NSNumber *)token size:(CGSize)size
+{
+    @autoreleasepool {
+        [condition lock];
+        [pending removeObjectForKey:token]; [condition broadcast];
+        if (time > clock.latest && clock.latest > 0 && time - clock.latest >= .001)
+            period = fmin(period, time - clock.latest);
+        if (cx_frame_stats || cx_frame_pacing) cx_frame_record(&clock, time);
+        double now = CACurrentMediaTime();
+        if (!output || !isfinite(time) || time <= 0 || now - last_report < 1) { [condition unlock]; return; }
+        last_report = now;
+        struct cx_frame_summary s = cx_frame_summarize(&clock);
+        NSMutableArray *intervals = [NSMutableArray arrayWithCapacity:s.count];
+        for (unsigned i=0; i<s.count; ++i) [intervals addObject:@(s.intervals[i])];
+        NSDictionary *snapshot = @{
+            @"version": @1, @"profile": [NSString stringWithUTF8String:getprogname() ?: "unknown"],
+            @"pid": @(getpid()), @"last_presented": @(clock.latest), @"updated_at": @([[NSDate date] timeIntervalSince1970]),
+            @"width": @(size.width), @"height": @(size.height), @"samples": @(s.count),
+            @"fps": @(s.fps), @"mean_ms": @(s.mean_ms), @"p95_ms": @(s.p95_ms), @"p99_ms": @(s.p99_ms),
+            @"low1_fps": @(s.low1_fps), @"max_ms": @(s.max_ms), @"intervals_ms": intervals,
+            @"limit_fps": @(cx_frame_fps), @"pacing": @(cx_frame_pacing), @"feedback_timeouts": @(timeouts)
+        };
+        [condition unlock];
+        /* Serialization and atomic file replacement happen off the render and
+         * Metal callback threads; at most one small snapshot per second/layer. */
+        static dispatch_queue_t writer;
+        static dispatch_once_t once;
+        dispatch_once(&once, ^{ writer = dispatch_queue_create("local.coeditor.frame-stats", DISPATCH_QUEUE_SERIAL); });
+        dispatch_async(writer, ^{
+            @autoreleasepool {
+                NSData *data = [NSJSONSerialization dataWithJSONObject:snapshot options:0 error:NULL];
+                [data writeToFile:output options:NSDataWritingAtomic error:NULL];
+            }
+        });
+    }
+}
+@end
+
+static CXFrameControl *cx_control_for_layer(CAMetalLayer *layer)
+{
+    static char key;
+    CXFrameControl *control = objc_getAssociatedObject(layer, &key);
+    if (!control) {
+        control = [[CXFrameControl alloc] init];
+        objc_setAssociatedObject(layer, &key, control, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        [control release];
+    }
+    return control;
+}
