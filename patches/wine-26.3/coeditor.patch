+        char marker[4096] = {0};
+        const char *prefix = getenv("WINEPREFIX");
+        bool marker_present = false;
+        if (prefix && getprogname() && !strcasecmp(getprogname(), "cs2.exe"))
+        {
+            snprintf(marker, sizeof(marker), "%s/drive_c/.cx-input-access-request", prefix);
+            marker_present = !access(marker, F_OK);
+        }
+        if (((request && !strcmp(request, "1")) || marker_present) && !requested_access)
+        {
