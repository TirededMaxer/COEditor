+static void cx_hid_wheel_matched(void *context, IOReturn result, void *sender, IOHIDDeviceRef device)
+{
+    CFArrayRef elements = IOHIDDeviceCopyMatchingElements(device, NULL, kIOHIDOptionsTypeNone);
+    if (!elements) return;
