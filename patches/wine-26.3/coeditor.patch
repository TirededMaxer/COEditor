+
+static void post_mouse_movement(double delta_x, double delta_y, double timestamp)
+{
+    WineApplicationController *controller;
+    WineWindow *window;
+    macdrv_event *event;
+
+    if (!macdrv_gcmouse_input_active() || !NSApp || ![NSApp isActive] || (!delta_x && !delta_y)) return;
+
+    controller = [WineApplicationController sharedController];
+    window = [controller mouseCaptureWindow] ?: [controller frontWineWindow];
+    if (!window) return;
+
+    int dx = macdrv_take_fraction(&remainder_x, delta_x);
+    int dy = macdrv_take_fraction(&remainder_y, delta_y);
+    if (!dx && !dy) return;
+
+    event = macdrv_create_event(MOUSE_MOVED_RAW, window);
+    event->mouse_moved.x = dx;
+    event->mouse_moved.y = dy;
+    event->mouse_moved.time_ms = [controller ticksForEventTime:timestamp];
+    [window.queue postEvent:event];
+    macdrv_release_event(event);
+}
+
+
+static CGEventRef native_mouse_callback(CGEventTapProxy proxy, CGEventType type, CGEventRef event, void *context)
+{
+    if (type == kCGEventTapDisabledByTimeout)
+    {
+        if (native_mouse_tap) CGEventTapEnable(native_mouse_tap, true);
+        return event;
+    }
+    if (type == kCGEventTapDisabledByUserInput)
+    {
+        __atomic_store_n(&gcmouse_active, false, __ATOMIC_SEQ_CST);
+        fprintf(stderr, "[CXMousePatch2] native tap suspended; using normal NSEvent input\n");
+        return event;
+    }
+    if (!event || !NSApp || ![NSApp isActive]) return event;
+
+    @autoreleasepool
+    {
+        NSEvent *native_event = [NSEvent eventWithCGEvent:event];
+        WineApplicationController *controller = [WineApplicationController sharedController];
+        double timestamp = [native_event timestamp];
+        double scale = retina_on ? 2 : 1;
+        if (!native_event || timestamp <= [controller lastSetCursorPositionTime]) return event;
+
+        /* Observe only events already addressed to this process. The Quartz
+         * event keeps the system's processed deltas, before AppKit's queue.
+         * No synthetic acceleration curve or temporal filter is applied. */
+        post_mouse_movement([native_event deltaX] * scale, [native_event deltaY] * scale, timestamp);
+    }
+    return event; /* listen-only: never suppress or alter the macOS event */
+}
+
+
+static bool start_native_mouse_input(void)
+{
+    CGEventMask mask = CGEventMaskBit(kCGEventMouseMoved) |
+                       CGEventMaskBit(kCGEventLeftMouseDragged) |
+                       CGEventMaskBit(kCGEventRightMouseDragged) |
+                       CGEventMaskBit(kCGEventOtherMouseDragged);
+    native_mouse_tap = CGEventTapCreateForPid(getpid(), kCGTailAppendEventTap,
+                        kCGEventTapOptionListenOnly, mask, native_mouse_callback, NULL);
+    if (!native_mouse_tap) return false;
+    native_mouse_source = CFMachPortCreateRunLoopSource(NULL, native_mouse_tap, 0);
+    if (!native_mouse_source)
+    {
+        CFMachPortInvalidate(native_mouse_tap);
+        CFRelease(native_mouse_tap);
+        native_mouse_tap = NULL;
+        return false;
+    }
+    CFRunLoopAddSource(CFRunLoopGetMain(), native_mouse_source, kCFRunLoopCommonModes);
+    CGEventTapEnable(native_mouse_tap, true);
+    __atomic_store_n(&gcmouse_active, true, __ATOMIC_SEQ_CST);
+    fprintf(stderr, "[CXMousePatch2] native macOS input enabled (own-process mouse-only event tap)\n");
+    return true;
+}
+
+
+static void configure_mouse(GCMouse *mouse)
+{
+    GCMouseInput *input;
+
+    if (!mouse || [configured_mice containsObject:mouse]) return;
+
+    if (!(input = [mouse mouseInput])) return;
+
+    [mouse setHandlerQueue:dispatch_get_main_queue()];
+    [input setMouseMovedHandler:^(GCMouseInput *input, float delta_x, float delta_y) {
+        post_mouse_movement(delta_x, -delta_y, [[NSProcessInfo processInfo] systemUptime]);
+    }];
+
+    [configured_mice addObject:mouse];
+    fprintf(stderr, "[CXMousePatch] GCMouse attached; devices=%lu\n", (unsigned long)[configured_mice count]);
+    __atomic_store_n(&gcmouse_active, true, __ATOMIC_SEQ_CST);
+}
+
+
+static void remove_mouse(GCMouse *mouse)
+{
+    if (!mouse || ![configured_mice containsObject:mouse]) return;
+
+    [[mouse mouseInput] setMouseMovedHandler:nil];
+    [configured_mice removeObject:mouse];
+    __atomic_store_n(&gcmouse_active, [configured_mice count] != 0, __ATOMIC_SEQ_CST);
+}
+
+
+static void stop_gcmouse_input(void)
+{
+    NSNotificationCenter *center;
+    WineApplicationController *controller;
+    GCMouse *mouse;
+
+    if (!observing_mice && !native_mouse_tap) return;
+
+    if (native_mouse_tap)
+    {
+        CFRunLoopRemoveSource(CFRunLoopGetMain(), native_mouse_source, kCFRunLoopCommonModes);
+        CFMachPortInvalidate(native_mouse_tap);
+        CFRelease(native_mouse_source);
+        CFRelease(native_mouse_tap);
