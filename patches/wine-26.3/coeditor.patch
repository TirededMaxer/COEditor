+    IOHIDManagerClose(cx_raw_wheel_manager, kIOHIDOptionsTypeNone);
+    CFRelease(cx_raw_wheel_manager);
+    cx_raw_wheel_manager = NULL;
+    CFRelease(cx_raw_wheel_devices);
+    cx_raw_wheel_devices = NULL;
+}
+
+static void cx_start_raw_wheel(void)
