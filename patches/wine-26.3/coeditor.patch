+    if (!cx_raw_wheel_manager) return;
+    cx_raw_wheel_devices = CFSetCreateMutable(kCFAllocatorDefault, 0, &kCFTypeSetCallBacks);
+    IOHIDManagerSetDeviceMatching(cx_raw_wheel_manager, (CFDictionaryRef)@{
+        @kIOHIDDeviceUsagePageKey: @1, @kIOHIDDeviceUsageKey: @2 });
+    IOHIDManagerSetInputValueMatchingMultiple(cx_raw_wheel_manager, (CFArrayRef)@[
+        @{ @kIOHIDElementUsagePageKey: @1, @kIOHIDElementUsageKey: @0x38 },
+        @{ @kIOHIDElementUsagePageKey: @0x0c, @kIOHIDElementUsageKey: @0x238 } ]);
+    IOHIDManagerRegisterDeviceMatchingCallback(cx_raw_wheel_manager, cx_hid_wheel_matched, NULL);
+    IOHIDManagerRegisterDeviceRemovalCallback(cx_raw_wheel_manager, cx_hid_wheel_removed, NULL);
+    IOHIDManagerRegisterInputValueCallback(cx_raw_wheel_manager, cx_hid_wheel_value, NULL);
+    IOHIDManagerScheduleWithRunLoop(cx_raw_wheel_manager, CFRunLoopGetMain(), kCFRunLoopCommonModes);
+    status = IOHIDManagerOpen(cx_raw_wheel_manager, kIOHIDOptionsTypeNone);
