+static void start_gcmouse_input(void)
+{
+    NSNotificationCenter *center;
+    WineApplicationController *controller;
+    GCMouse *mouse;
+
+    struct cx_tuner_settings tuning = cx_tuner_read();
+    if (tuning.loaded && !tuning.mouse) { stop_gcmouse_input(); return; }
+    if (!use_gcmouse) return;
+    if (observing_mice || native_mouse_tap) return;
+
+    const char *mode = tuning.loaded ? "native" : getenv("CX_MOUSE_INPUT");
+    if (mode && !strcmp(mode, "native"))
+    {
+        if (start_native_mouse_input()) return;
+        fprintf(stderr, "[CXMousePatch2] native tap unavailable; falling back to GCMouse raw input\n");
+    }
